# Copy to .env and fill in. Never commit .env.
# TMDB: https://www.themoviedb.org/settings/api (v3 key or v4 read token both work)
TMDB_API_KEY=
# No ANTHROPIC_API_KEY needed: scoring runs through the Claude Code CLI on the
# subscription (see claude_cli.py). Optional override of the CLI binary path:
# CLAUDE_CLI=/path/to/claude
